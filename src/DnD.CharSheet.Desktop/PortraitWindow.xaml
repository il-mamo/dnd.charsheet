<Window x:Class="DnD.CharSheet.Desktop.PortraitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 Title="Portrait" Width="960" Height="720" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}" FontFamily="Segoe UI" FontSize="16">
 <Window.Resources>
  <DrawingImage x:Key="PortraitFallback"><DrawingImage.Drawing><DrawingGroup>
   <GeometryDrawing Brush="{DynamicResource Brush.SurfaceMuted}" Geometry="M0,0 L64,0 64,64 0,64 Z"/>
   <GeometryDrawing Brush="{DynamicResource Brush.TextSecondary}"><GeometryDrawing.Geometry><EllipseGeometry Center="32,22" RadiusX="10" RadiusY="10"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="{DynamicResource Brush.TextSecondary}" Geometry="M12,56 C12,40 20,34 32,34 C44,34 52,40 52,56 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="Heading" FontFamily="Georgia" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"/>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
 <StackPanel>
 <Button x:Name="Choose" Content="Choose image" AutomationProperties.Name="Choose portrait image" Click="ChooseImage" HorizontalAlignment="Left" Margin="0,0,0,12"/>
 <TextBlock x:Name="Filename" Text="No image chosen" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
 <TextBlock Text="JPEG or PNG · up to 10 MiB · up to 4096 × 4096 · up to 16 million pixels" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"/>
 <TextBlock x:Name="Validation" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" automation:AutomationProperties.LiveSetting="Polite"/>
 <Border Background="{DynamicResource Brush.SurfaceMuted}" Width="400" Height="400" HorizontalAlignment="Left" Margin="0,8,0,12"><Grid><Image x:Name="Original" Source="{StaticResource PortraitFallback}" Stretch="Uniform" AutomationProperties.Name="Original portrait"/><TextBlock x:Name="Empty" Text="No portrait" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"/></Grid></Border>
 <GroupBox Header="Framing" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" Padding="8"><StackPanel><RadioButton x:Name="Fit" GroupName="Framing" Content="Fit whole image" IsChecked="True" Checked="FramingChanged" Margin="0,0,0,8"/><RadioButton x:Name="Crop" GroupName="Framing" Content="Center crop" Checked="FramingChanged"/></StackPanel></GroupBox>
 </StackPanel>
 <StackPanel Grid.Column="2"><TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Square" Margin="0,0,0,8"/><Border Width="160" Height="160" Background="{DynamicResource Brush.SurfaceMuted}" HorizontalAlignment="Left"><Image x:Name="Square" Source="{StaticResource PortraitFallback}" Stretch="Fill"/></Border><TextBlock Text="Thumbnail" Margin="0,16,0,8"/><Grid Width="96" Height="96" HorizontalAlignment="Left" Background="{DynamicResource Brush.SurfaceMuted}"><Grid.Clip><EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/></Grid.Clip><Image x:Name="Circle" Source="{StaticResource PortraitFallback}" Stretch="Fill" AutomationProperties.Name="Circular portrait preview"/></Grid></StackPanel>
 </Grid></ScrollViewer>
 <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Status" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
 <DockPanel><Button x:Name="Remove" Content="Remove portrait" Click="RemovePortrait" DockPanel.Dock="Left" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Click="CancelPortrait" Margin="0,0,12,0"/><Button x:Name="Apply" Content="Apply portrait" Style="{StaticResource PrimaryButton}" Click="ApplyPortrait"/></StackPanel></DockPanel>
 </StackPanel>
 </Grid></Border>
</Window>


