<UserControl x:Class="DnD.CharSheet.Desktop.PortraitThumbnail" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <Grid Background="{DynamicResource Brush.SurfaceMuted}">
  <Grid.Clip><EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/></Grid.Clip>
  <Viewbox x:Name="Fallback" Margin="8"><Canvas Width="64" Height="64"><Ellipse Canvas.Left="22" Canvas.Top="12" Width="20" Height="20" Fill="{DynamicResource Brush.TextSecondary}"/><Path Data="M12,56 C12,40 20,34 32,34 C44,34 52,40 52,56 Z" Fill="{DynamicResource Brush.TextSecondary}"/></Canvas></Viewbox>
  <Image x:Name="Picture" Stretch="UniformToFill"/>
 </Grid>
</UserControl>
