<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<Color x:Key="Color.Canvas">#101419</Color>
<Color x:Key="Color.Surface">#1B222A</Color>
<Color x:Key="Color.SurfaceMuted">#252E38</Color>
<Color x:Key="Color.Text">#F0EADF</Color>
<Color x:Key="Color.TextSecondary">#B8C1CC</Color>
<Color x:Key="Color.Border">#7D8997</Color>
<Color x:Key="Color.Divider">#3A4552</Color>
<Color x:Key="Color.Accent">#922F49</Color>
<Color x:Key="Color.AccentHover">#A83A55</Color>
<Color x:Key="Color.AccentPressed">#7C263D</Color>
<Color x:Key="Color.Selection">#34485C</Color>
<Color x:Key="Color.DangerFill">#8F2938</Color>
<Color x:Key="Color.OnAccent">#FFFFFF</Color>
<Color x:Key="Color.OnSelection">#F0EADF</Color>
<Color x:Key="Color.Focus">#8BC9EF</Color>
<Color x:Key="Color.Success">#8DC8A4</Color>
<Color x:Key="Color.Warning">#E5BE74</Color>
<Color x:Key="Color.Danger">#FF9C9E</Color>
<Color x:Key="Color.Brass">#B89A60</Color>
<sys:Double x:Key="Space.4">4</sys:Double>
<sys:Double x:Key="Space.8">8</sys:Double>
<sys:Double x:Key="Space.12">12</sys:Double>
<sys:Double x:Key="Space.16">16</sys:Double>
<sys:Double x:Key="Space.24">24</sys:Double>
<sys:Double x:Key="Space.32">32</sys:Double>
 <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>
 <FontFamily x:Key="Font.Heading">Georgia, Segoe UI</FontFamily>
 <sys:Double x:Key="Type.Body">14</sys:Double>
 <sys:Double x:Key="Type.Helper">12</sys:Double>
 <sys:Double x:Key="Type.Heading">24</sys:Double>
 <sys:Double x:Key="Type.SectionHeading">18</sys:Double>
 <sys:Double x:Key="Type.Stat">28</sys:Double>
 <sys:Double x:Key="Size.Input">36</sys:Double>
 <sys:Double x:Key="Size.Icon.Inline">16</sys:Double>
 <sys:Double x:Key="Size.Icon.Toolbar">20</sys:Double>
 <CornerRadius x:Key="Radius.Control">4</CornerRadius>
 <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
 <Thickness x:Key="Border.Normal">1</Thickness>
 <Thickness x:Key="Border.Focus">2</Thickness>
 <Thickness x:Key="Padding.Panel">16</Thickness>
 <Thickness x:Key="Padding.Page">24</Thickness>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontFamily" Value="{StaticResource Font.Heading}"/><Setter Property="FontSize" Value="{StaticResource Type.Heading}"/><Setter Property="FontWeight" Value="Bold"/>
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Heading}"><Setter Property="FontSize" Value="{StaticResource Type.SectionHeading}"/></Style>
 <Style x:Key="Helper" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource Type.Helper}"/></Style>
 <Style x:Key="SectionPanel" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
  <Setter Property="BorderThickness" Value="{StaticResource Border.Normal}"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/><Setter Property="Padding" Value="{StaticResource Padding.Page}"/>
 </Style>
 <Style x:Key="Destination" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}"/><Setter Property="BorderThickness" Value="{StaticResource Border.Normal}"/>
  <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="{StaticResource Size.Input}"/>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection}"/>
  <Setter Property="SelectionTextBrush" Value="{DynamicResource Brush.OnSelection}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
  <Setter Property="BorderThickness" Value="{StaticResource Border.Normal}"/>
  <Setter Property="MinHeight" Value="{StaticResource Size.Input}"/>
  <Setter Property="Padding" Value="8"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
   </Border><Border x:Name="FocusRing" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Control}" BorderThickness="{StaticResource Border.Focus}" BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="{StaticResource Border.Normal}"/>
  <Setter Property="MinHeight" Value="{StaticResource Size.Input}"/><Setter Property="Padding" Value="12,8"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="Frame" CornerRadius="{StaticResource Radius.Control}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border><Border x:Name="FocusRing" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Control}" BorderThickness="{StaticResource Border.Focus}" BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed"/></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Selection}"/><Setter Property="Foreground" Value="{DynamicResource Brush.OnSelection}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/><Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="Frame" CornerRadius="{StaticResource Radius.Control}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border><Border x:Name="FocusRing" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Control}" BorderThickness="{StaticResource Border.Focus}" BorderBrush="{DynamicResource Brush.Focus}" Visibility="Collapsed"/></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.AccentHover}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.AccentPressed}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
