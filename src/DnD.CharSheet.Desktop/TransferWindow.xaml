<Window x:Class="DnD.CharSheet.Desktop.TransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DnD.CharSheet.Desktop" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 Title="Transfer character" Width="960" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}" FontFamily="Segoe UI" FontSize="16">
 <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Transfer character" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
     <DockPanel Margin="0,0,0,16">
      <local:PortraitThumbnail x:Name="Portrait" DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0"/>
      <StackPanel><TextBlock x:Name="CharacterName" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Incomplete draft" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0"/></StackPanel>
     </DockPanel>
     <TextBlock x:Name="Source" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <StackPanel x:Name="Picker">
      <Label Content="To Adventure (required)" Target="{Binding ElementName=Destinations}" Foreground="{DynamicResource Brush.Text}" Padding="0" Margin="0,0,0,8"/>
      <TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Search destination Adventures" Margin="0,0,0,8"/>
      <ListBox x:Name="Destinations" Height="124" SelectionChanged="DestinationChanged" AutomationProperties.Name="To Adventure, required" Background="{DynamicResource Brush.SurfaceMuted}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
         <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
           <Border x:Name="ItemBorder" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="2" Padding="8"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Selection}"/><Setter Property="Foreground" Value="{DynamicResource Brush.OnSelection}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value></Setter>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
     <TextBlock x:Name="Preview" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Button x:Name="Manage" Content="Manage source Adventure" Click="ManageClicked" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,16" automation:AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Transfer status"/>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="Cancel" Content="Cancel" AutomationProperties.Name="Cancel transfer" Click="CancelClicked" MinHeight="40" Margin="0,0,12,0"/>
    <Button x:Name="Confirm" Content="Transfer character" Click="ConfirmClicked" IsEnabled="False" Style="{StaticResource PrimaryButton}" MinHeight="40"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
