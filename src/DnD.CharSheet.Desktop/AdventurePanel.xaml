<UserControl x:Class="DnD.CharSheet.Desktop.AdventurePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DnD.CharSheet.Desktop" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
  <local:AdventureMemberCountConverter x:Key="AdventureMemberCount" />
  <Style TargetType="Label">
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="RequiresAdventure" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding ManagementSelection}" Value="{x:Null}">
     <Setter Property="IsEnabled" Value="False" />
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OpenAdventureButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding ManagementSelection}" Value="{x:Null}">
     <Setter Property="IsEnabled" Value="False" />
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="AssignAdventureButton" TargetType="Button" BasedOn="{StaticResource RequiresAdventure}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding SelectedUnassigned}" Value="{x:Null}">
     <Setter Property="IsEnabled" Value="False" />
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
       <ScrollViewer Focusable="False" Padding="0">
        <ItemsPresenter />
       </ScrollViewer>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Setter Property="ItemContainerStyle">
    <Setter.Value>
     <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="ItemBorder" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="2" Padding="0">
          <ContentPresenter HorizontalAlignment="Stretch" />
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
           <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
           <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Selection}" />
           <Setter Property="Foreground" Value="{DynamicResource Brush.OnSelection}" />
           <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
           <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
          </Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid MaxWidth="1648" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="AdventureStatusText" Text="{Binding AdventureStatus}" AutomationProperties.Name="Adventure status" automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" TextWrapping="Wrap" />
   <WrapPanel>
    <Button Content="Retry loading Adventures" Command="{Binding InitializeCommand}" Visibility="{Binding HasFailed, Converter={StaticResource BooleanVisibility}}" Margin="0,0,12,12" />
    <Button Content="Retry draft recovery" Command="{Binding RetryRecoveryCommand}" Visibility="{Binding HasRecoveryError, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,12" />
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1040" />
    <ColumnDefinition Width="24" />
    <ColumnDefinition Width="584" />
   </Grid.ColumnDefinitions>
   <Border>
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource SectionPanel}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsAdventureBusy}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
       </DataTrigger>
       <DataTrigger Binding="{Binding HasAdventureConfirmation}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
     </Grid.RowDefinitions>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Retry / Refresh" Command="{Binding RefreshAdventuresCommand}" AutomationProperties.Name="Refresh Adventures" Margin="12,0,0,0" />
      <TextBlock Text="Select Adventure" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
     </DockPanel>
     <Label Grid.Row="1" Target="{Binding ElementName=AdventureSearch}" Content="Search Adventures" Padding="0" Margin="0,12,0,8" />
     <StackPanel Grid.Row="2">
      <TextBox x:Name="AdventureSearch" TextChanged="SearchChanged" AutomationProperties.Name="Search Adventures" Margin="0,0,0,8" />
      <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" automation:AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <ListBox Grid.Row="3" x:Name="AdventureList" ItemsSource="{Binding Adventures}" SelectedItem="{Binding ManagementSelection, Mode=TwoWay}" AutomationProperties.Name="Adventures" HorizontalContentAlignment="Stretch" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="12">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
         <TextBlock FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0">
          <TextBlock.Text>
           <MultiBinding Converter="{StaticResource AdventureMemberCount}">
            <Binding Path="Id" />
            <Binding Path="DataContext.AdventureMemberCounts" RelativeSource="{RelativeSource AncestorType=UserControl}" />
           </MultiBinding>
          </TextBlock.Text>
         </TextBlock>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="4" Margin="0,16,0,8">
      <TextBlock Text="Unassigned characters" Style="{StaticResource SectionHeading}" />
      <TextBlock Text="{Binding UnassignedStatus, FallbackValue=Characters are kept here until assigned to an Adventure.}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" />
     </StackPanel>
     <ListBox Grid.Row="5" ItemsSource="{Binding UnassignedDrafts}" SelectedItem="{Binding SelectedUnassigned, Mode=TwoWay}" AutomationProperties.Name="Unassigned characters" HorizontalContentAlignment="Stretch" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <DockPanel Margin="12">
         <local:PortraitThumbnail DockPanel.Dock="Left" Width="48" Height="48" CharacterId="{Binding Id}" Portraits="{Binding Portraits, RelativeSource={RelativeSource AncestorType=Window}}" Refresh="{Binding PortraitRefresh, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" />
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Unassigned · Incomplete draft" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
         </StackPanel>
        </DockPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource SectionPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
     <StackPanel>
      <StackPanel x:Name="ManagementForms">
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsAdventureBusy}" Value="True">
           <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
          <DataTrigger Binding="{Binding HasAdventureConfirmation}" Value="True">
           <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Text="{Binding ManagementSelection.Name, TargetNullValue=Choose an Adventure, FallbackValue=Choose an Adventure}" Style="{StaticResource SectionHeading}" TextWrapping="Wrap" />
       <TextBlock Text="Characters in this Adventure" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,8" />
       <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl ItemsSource="{Binding PreviewMembers}" AutomationProperties.Name="Adventure member preview">
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="60" />
             <ColumnDefinition Width="*" />
             <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:PortraitThumbnail Width="48" Height="48" CharacterId="{Binding Id}" Portraits="{Binding Portraits, RelativeSource={RelativeSource AncestorType=Window}}" Refresh="{Binding PortraitRefresh, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
             <TextBlock Text="Incomplete draft" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Transfer…" Click="TransferMember" Margin="8,0,0,0">
             <AutomationProperties.Name><Binding Path="Name" StringFormat="Transfer {0}"/></AutomationProperties.Name>
            </Button>
           </Grid>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
       <Button Content="Open Adventure" Command="{Binding OpenAdventureCommand}" CommandParameter="{Binding ManagementSelection}" Style="{StaticResource OpenAdventureButton}" HorizontalAlignment="Left" Margin="0,16,0,12" />
       <Button Content="Back to selection" Command="{Binding ReturnToSelectionCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />
       <TextBlock Text="Manage selected Adventure" Style="{StaticResource SectionHeading}" />
       <Label Target="{Binding ElementName=AdventureName}" Content="Adventure name (required)" Padding="0" Margin="0,12,0,8" />
       <TextBox x:Name="AdventureName" Text="{Binding AdventureNameInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adventure name, required" MaxLength="80" />
       <TextBlock Text="Use 1–80 characters. Rename changes only the selected Adventure." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" Margin="0,8,0,12" />
       <WrapPanel>
        <Button Content="Rename" Style="{StaticResource RequiresAdventure}" Command="{Binding RenameAdventureCommand}" Margin="0,0,12,8" />
        <Button Content="Delete Adventure…" Style="{StaticResource RequiresAdventure}" Command="{Binding RequestDeleteAdventureCommand}" Margin="0,0,0,8" />
       </WrapPanel>
       <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,16" />
       <Button Content="Create Adventure…" Click="ShowCreateForm" HorizontalAlignment="Left" Margin="0,0,0,12" />
       <StackPanel x:Name="CreateForm" Visibility="Collapsed">
        <TextBlock Text="Create Adventure with first character" Style="{StaticResource SectionHeading}" TextWrapping="Wrap" />
        <Label Target="{Binding ElementName=NewAdventureName}" Content="New Adventure name (required)" Padding="0" Margin="0,12,0,8" />
        <TextBox x:Name="NewAdventureName" Text="{Binding NewAdventureNameInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New Adventure name, required" MaxLength="80" />
        <TextBlock Text="Enter a new draft name, or select an unassigned character from the list." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,8" />
        <Label Target="{Binding ElementName=FirstCharacterName}" Content="New character name" Padding="0" Margin="0,4,0,8" />
        <TextBox x:Name="FirstCharacterName" Text="{Binding FirstCharacterName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First character name" MaxLength="80">
         <TextBox.Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
           <Setter Property="IsEnabled" Value="False" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedUnassigned}" Value="{x:Null}">
             <Setter Property="IsEnabled" Value="True" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBox.Style>
        </TextBox>
        <TextBlock Text="{Binding SelectedUnassigned.Name, StringFormat=First-character choice: assign {0}, TargetNullValue=First-character choice: create a new draft, FallbackValue=First-character choice: create a new draft}" TextWrapping="Wrap" Margin="0,12,0,8" />
        <Button Content="Use a new draft instead" Click="ClearUnassigned" HorizontalAlignment="Left" Margin="0,0,0,12" />
        <WrapPanel>
         <Button Content="Cancel" Click="HideCreateForm" Margin="0,0,12,0" />
         <Button Content="Create Adventure" Command="{Binding CreateAdventureCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
        </WrapPanel>
       </StackPanel>
       <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,16" />
       <TextBlock Text="Assign unassigned character" Style="{StaticResource SectionHeading}" />
       <TextBlock Text="Select an unassigned character and the destination Adventure in the lists, then review the assignment." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,12" />
       <Button Content="Assign Adventure…" Style="{StaticResource AssignAdventureButton}" Command="{Binding RequestAssignCharacterCommand}" HorizontalAlignment="Left" />
      </StackPanel>
      <Border Visibility="{Binding HasAdventureConfirmation, Converter={StaticResource BooleanVisibility}}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="Review change" Style="{StaticResource SectionHeading}" />
        <TextBlock x:Name="ConfirmationStatusText" Text="{Binding ConfirmationText}" TextWrapping="Wrap" Margin="0,12" AutomationProperties.Name="Adventure change confirmation" automation:AutomationProperties.LiveSetting="Polite" />
        <WrapPanel>
         <WrapPanel.Style>
          <Style TargetType="WrapPanel">
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsAdventureBusy}" Value="True">
             <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </WrapPanel.Style>
         <Button x:Name="CancelConfirmation" Content="Cancel" Command="{Binding CancelAdventureActionCommand}" Margin="0,0,12,8" />
         <Button Content="{Binding ConfirmationActionLabel, FallbackValue=Confirm change}" Command="{Binding ConfirmAdventureActionCommand}" Margin="0,0,0,8" />
        </WrapPanel>
       </StackPanel>
      </Border>
      <TextBox x:Name="RetainedRecovery" Text="{Binding RetainedRecoveryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" Margin="0,16,0,0" AutomationProperties.Name="Retained draft recovery" VerticalScrollBarVisibility="Auto" MaxHeight="160">
       <TextBox.Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding RetainedRecoveryText}" Value="">
           <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Binding="{Binding RetainedRecoveryText}" Value="{x:Null}">
           <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBox.Style>
      </TextBox>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
